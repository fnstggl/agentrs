 "identification_note": "Observational: MIND records the production recommender's impressions; which news were shown depended on the user, so click probabilities are conditional on that selection and the feature effects are associations, not effects of exposure.",
 "extrapolation_limits": "Evidence: MIND-small, 50,000 sampled Microsoft News users (English, US market), impressions 2019-11-09..15 chosen by the production recommender. The simulator may use this model for the probability that an individual opens an article shown in a slate of news/article recommendations, given text affinity to its history, topic shares, popularity, freshness and slate size. It may NOT infer: (1) clicks on video or social posts (use content_consumption); (2) behaviour of populations, languages or periods other than US Microsoft News in November 2019; (3) the causal effect of showing an item (exposure was chosen by a recommender; there is no randomised exposure in MIND); (4) dwell or reading time (not in the data); (5) raw affinity values from a different encoder (use text_cos_z, or quantile-map text_cos). Popularity counts come from a 50k-user sample and are used per capita. News first shown on 2019-11-09 have left-censored ages.",
 "feature_map": {
  "text_cos": "cosine between the item's text embedding and the mean embedding of the individual's consumed items (here: 128-d LSA of TF-IDF; with another encoder map by quantile, card feature_quantiles)",
  "text_cos_z": "text_cos standardised within the slate the individual is shown (scale-free; use as is)",
  "cat_share": "(individual's past consumption in the item's category + s) / (past consumption + 1), s = population share of the category",
  "subcat_share": "the same for the finer topic (subcategory)",
  "log_hist_len": "log1p(number of items in the individual's consumption history)",
  "pop_ctr_24h": "(clicks + 10 m) / (impressions + 10) of the item in the previous 24 simulated hours, m = card prior_rate",
  "pop_log_clicks_per_1k": "log1p(1000 * clicks of the item in the previous 24 h / individuals active in those 24 h)",
  "age_log_hours": "log1p(hours since the item was first shown on the platform)",
  "slate_size_log": "log1p(number of items in the slate / page the individual is shown)"
 },
