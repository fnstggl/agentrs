# Copy to .env (never commit .env). Secrets go to your secret manager; this file holds
# references and non-secret settings. Do not paste secret values into an AI conversation.
AGENTRS_DATABASE_URL=postgresql+psycopg://agentrs:CHANGE_ME@postgres:5432/agentrs
AGENTRS_REDIS_URL=redis://redis:6379/0
AGENTRS_S3_ENDPOINT=http://minio:9000
AGENTRS_S3_BUCKET=agentrs-artifacts
AWS_ACCESS_KEY_ID=CHANGE_ME_MINIO_USER
AWS_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_PASSWORD
AGENTRS_DATA_DIR=/data
AGENTRS_PLATFORMS=/app/config/platforms.yaml
AGENTRS_PERMISSIONS=/app/config/permissions.yaml
AGENTRS_AGENTS=/app/config/agents.yaml
# Encryption key for the runtime secret file (OAuth tokens obtained at runtime) and browser sessions.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENTRS_SECRET_KEY=CHANGE_ME
# Operator token for the control API / dashboard (long random string).
AGENTRS_OPERATOR_TOKEN=CHANGE_ME
# Public base URL of the control API (OAuth callbacks: <base>/oauth/callback; webhooks: <base>/webhooks/<provider>)
AGENTRS_PUBLIC_BASE_URL=https://agents.example.org
# Inference endpoint (mock | local | OpenAI-compatible vLLM/SGLang URL)
AGENTRS_INFERENCE_URL=http://inference:8100
# Provider credentials are injected by the secret manager as AGENTRS_SECRET_<NAME>, e.g.:
#   AGENTRS_SECRET_BLUESKY_APP_PASSWORD, AGENTRS_SECRET_GITHUB_APP_KEY, AGENTRS_SECRET_DISCORD_BOT_TOKEN,
#   AGENTRS_SECRET_MASTODON_CLIENT_SECRET, AGENTRS_SECRET_SMTP_PASSWORD, AGENTRS_SECRET_GITHUB_WEBHOOK_SECRET
# and referenced from account records as secret://env/<name>.
# Optional tracing
OTEL_EXPORTER_OTLP_ENDPOINT=
