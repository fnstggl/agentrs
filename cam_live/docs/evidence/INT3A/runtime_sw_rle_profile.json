   "status": "ok",
   "args": "{\"content\": \"def solve(s: str) -> str:\\n    result = ''\\n    i = 0\\n    while i < len(s):\\n        j = i\\n        while j < len(s) and s[j] == s[i]:\\n            j += 1\\n        count = j - i\\n        if count > 1:\\n            result += f'{count}{s[i]}'\\n        else:\\n            result += s[i]\\n "
  }
